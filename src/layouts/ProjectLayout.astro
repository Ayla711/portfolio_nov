---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  compact?: boolean;
}

const { title, description, canonicalPath, compact = false } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
>
  <main
    id="main-content"
    class:list={["project-layout", { "project-layout--compact": compact }]}
  >
    <slot />
  </main>
</BaseLayout>

<style>
  .project-layout {
    width: min(100%, var(--content-max));
    margin-inline: auto;
    border-right: var(--line);
    border-left: var(--line);
    background: rgba(251, 252, 251, 0.38);
  }

  .project-layout--compact {
    --section-space: clamp(2.5rem, 4vw, 4rem);
  }

  .project-layout--compact :global(.project-hero) {
    gap: 1.5rem;
    padding-top: clamp(2rem, 4vw, 3.5rem);
  }

  .project-layout--compact :global(.hero-heading) {
    width: min(100%, 64rem);
    justify-self: center;
    gap: 1rem 1.5rem;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
  }

  .project-layout--compact :global(.hero-heading > div) {
    display: contents;
  }

  .project-layout--compact :global(.hero-heading .eyebrow) {
    grid-column: 1 / -1;
  }

  .project-layout--compact :global(h1) {
    margin-top: 0;
    font-size: clamp(2.75rem, 5vw, 4.5rem);
  }

  /* Research / coursework titles are long: let them wrap on their own width
     and keep them small enough that the last word never runs into the
     summary column. */
  .project-layout--compact :global(.project-hero--research h1) {
    max-width: none;
    font-size: clamp(2.25rem, 3.6vw, 3.25rem);
    line-height: 1.05;
    text-wrap: balance;
  }

  .project-layout--compact :global(.hero-summary) {
    max-width: none;
    margin: 0;
    text-align: left;
    font-size: clamp(1.125rem, 1.5vw, 1.5rem);
  }

  .project-layout--compact :global(.hero-media) {
    position: relative;
    width: min(100%, 64rem);
    justify-self: center;
    aspect-ratio: 16 / 9;
    border: 0;
  }

  /* An image hero keeps the image's own 16:10 frame; the 16:9 frame above is
     for YouTube embeds. */
  .project-layout--compact :global(.hero-media:has(img)) {
    aspect-ratio: 16 / 10;
  }

  .project-layout--compact :global(.hero-media img) {
    height: 100%;
  }

  .project-layout--compact :global(.hero-media iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    transform: scale(1.015);
    transform-origin: center;
  }

  .project-layout--compact :global(.case-section) {
    column-gap: clamp(1.5rem, 4vw, 4rem);
    row-gap: 1.5rem;
  }

  .project-layout--compact :global(.section-heading h2) {
    margin-top: 0.75rem;
    font-size: clamp(1.8rem, 2.8vw, 2.75rem);
    max-width: 15ch;
  }

  .project-layout--compact :global(.section-content > p) {
    margin-bottom: 1rem;
    line-height: 1.55;
  }

  .project-layout--compact :global(.section-content > :last-child) {
    margin-bottom: 0;
  }

  .project-layout--compact
    :global(
      .media-figure,
      .process-figure,
      .comparison,
      .insight,
      .role-breakdown,
      .reflection-block
    ) {
    margin-block: 1.5rem;
  }

  .project-layout--compact :global(.insight blockquote) {
    font-size: clamp(1.5rem, 2.3vw, 2.25rem);
    line-height: 1.3;
  }

  .project-layout--compact :global(.reflection-block) {
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 1.5rem;
  }

  .project-layout--compact :global(.reflection-block h3) {
    max-width: 32ch;
    font-size: clamp(1.4rem, 2vw, 1.8rem);
  }

  .project-layout--compact :global(.project-navigation) {
    gap: 1.5rem;
  }

  .project-layout--compact :global(.navigation-heading h2) {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 3vw, 3rem);
  }

  .project-layout--compact :global(.project-links a) {
    min-height: 6rem;
    gap: 1rem;
    padding-block: 1rem;
  }

  .project-layout--compact :global(.back-link) {
    grid-column: auto;
  }

  /* With both previous and next links, "Back to …" is alone on the second
     row; let it span so its rule runs the full width. */
  .project-layout--compact :global(.project-links a:nth-child(2) + .back-link) {
    grid-column: 1 / -1;
  }

  @media (max-width: 48rem) {
    .project-layout--compact :global(.hero-heading) {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (max-width: 38rem) {
    .project-layout--compact :global(.project-hero--research h1) {
      max-width: none;
      font-size: clamp(2rem, 9vw, 2.75rem);
      overflow-wrap: anywhere;
    }
  }

  @media (max-width: 60rem) {
    .project-layout {
      border-right: 0;
      border-left: 0;
    }
  }
</style>
