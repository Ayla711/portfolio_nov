---
import { profileData } from "../../data/profile";

const { about } = profileData;
---

<section id="about-me" class="about-panel" aria-labelledby="about-title">
  <span id="about" class="anchor-alias" aria-hidden="true"></span>
  <h2 id="about-title" class="visually-hidden">About Me</h2>
  <div class="about-copy">
    <p class="introduction">
      <strong>{about.heading}</strong>{" "}
      {profileData.statement}
    </p>
    <p class="about-program">
      <span>{about.field}</span>
      <span class="about-separator" aria-hidden="true">|</span>
      <a href={about.program.url} target="_blank" rel="noopener"
        >{about.program.label}</a
      >
    </p>
  </div>
</section>

<style>
  .about-panel {
    position: relative;
    isolation: isolate;
    padding: 1.5rem 1.75rem 1.75rem;
    border: 1px solid rgba(38, 61, 88, 0.09);
    border-radius: 0.75rem;
    background:
      radial-gradient(
        ellipse at 0% 0%,
        rgba(223, 247, 242, 0.65),
        transparent 65%
      ),
      radial-gradient(
        ellipse at 100% 0%,
        rgba(170, 165, 232, 0.12),
        transparent 55%
      ),
      var(--color-surface-soft);
  }

  .about-copy {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
  }

  p {
    font-size: var(--text-body);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .introduction {
    color: var(--color-text-strong);
  }

  .about-program a {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .about-program a:hover,
  .about-program a:focus-visible {
    color: var(--color-accent);
  }

  .about-program {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.4em;
  }

  /* On phones the programme goes on its own line instead of breaking after
     the separator. */
  @media (max-width: 38rem) {
    .about-panel {
      padding: 1.25rem;
    }

    .about-separator {
      display: none;
    }

    .about-program a {
      flex-basis: 100%;
    }
  }
</style>
