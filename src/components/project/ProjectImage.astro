---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: "eager" | "lazy";
}

const {
  src,
  alt,
  widths = [480, 800, 1200, 1600],
  sizes = "(max-width: 960px) 100vw, 70vw",
  loading = "lazy",
} = Astro.props;
---

<Image class="project-image" {src} {alt} {widths} {sizes} {loading} />

<style>
  .project-image {
    width: 100%;
    height: auto;
  }
</style>
