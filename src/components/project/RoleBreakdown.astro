---
interface Props {
  label?: string;
}

const { label = "My role" } = Astro.props;
---

<aside class="role-breakdown">
  <p class="eyebrow">{label}</p>
  <div><slot /></div>
</aside>

<style>
  .role-breakdown {
    display: grid;
    grid-template-columns: minmax(7rem, 0.35fr) minmax(0, 1.65fr);
    gap: var(--space-6);
    margin-block: var(--space-10);
    padding: var(--space-6) 0;
    border-top: var(--line-strong);
    border-bottom: var(--line);
  }

  .role-breakdown :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 38rem) {
    .role-breakdown {
      grid-template-columns: 1fr;
    }
  }
</style>
