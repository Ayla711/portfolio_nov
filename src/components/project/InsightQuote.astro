---
interface Props {
  label?: string;
}

const { label = "Key insight" } = Astro.props;
---

<figure class="insight">
  <blockquote><slot /></blockquote>
  <figcaption>{label}</figcaption>
</figure>

<style>
  .insight {
    position: relative;
    margin: var(--space-10) 0;
    padding: var(--space-8) 0 var(--space-8) var(--space-8);
    border-top: var(--line-strong);
    border-bottom: var(--line);
  }

  .insight::before {
    position: absolute;
    top: var(--space-8);
    left: 0;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--gradient-signal);
    content: "";
    box-shadow: 0 0 1.5rem rgba(95, 88, 232, 0.5);
  }

  blockquote {
    margin: 0;
    color: var(--color-text-strong);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.4vw, 3.5rem);
    font-weight: 500;
    line-height: 1.16;
    letter-spacing: -0.035em;
  }

  figcaption {
    margin-top: var(--space-6);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
