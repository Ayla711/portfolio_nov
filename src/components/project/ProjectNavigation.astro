---
import type { CollectionEntry } from "astro:content";
import { siteData } from "../../data/site";
import { withBase } from "../../utils/url";

interface Props {
  previousProject?: CollectionEntry<"projects">;
  nextProject?: CollectionEntry<"projects">;
  homeSection?: "projects" | "others";
}

const { previousProject, nextProject, homeSection = "projects" } = Astro.props;
---

<section class="project-navigation" aria-labelledby="continue-title">
  <div class="navigation-heading">
    <p class="eyebrow">End of case study</p>
    <h2 id="continue-title">Thanks for passing by ~</h2>
  </div>

  <nav class="project-links" aria-label="Previous and next projects">
    {
      previousProject && (
        <a href={withBase(`project/${previousProject.id}/`)}>
          <span>← Previous project</span>
          <strong>{previousProject.data.title}</strong>
        </a>
      )
    }
    {
      nextProject && (
        <a href={withBase(`project/${nextProject.id}/`)}>
          <span>Next project →</span>
          <strong>{nextProject.data.title}</strong>
        </a>
      )
    }
    <a class="back-link" href={withBase(`#${homeSection}`)}>
      <span>Portfolio</span>
      <strong
        >{
          homeSection === "others"
            ? "Back to others"
            : "Back to selected projects"
        }</strong
      >
    </a>
  </nav>

  <div class="direct-links">
    <a class="text-link" href={`mailto:${siteData.email}`}>
      Email Ayla <span aria-hidden="true">↗</span>
    </a>
    {
      siteData.resumeUrl && (
        <a
          class="text-link"
          href={siteData.resumeUrl}
          target="_blank"
          rel="noreferrer"
        >
          View {siteData.resumeLabel} <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</section>

<style>
  .project-navigation {
    display: grid;
    gap: var(--space-16);
    padding: var(--section-space) var(--page-gutter);
    border-top: var(--line);
    background: var(--color-text-strong);
    color: rgba(255, 255, 255, 0.78);
  }

  .eyebrow {
    color: rgba(255, 255, 255, 0.5);
  }

  h2 {
    margin-top: var(--space-6);
    color: #ffffff;
    font-family: var(--font-serif);
    font-size: var(--text-section);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
  }

  .project-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid rgba(255, 255, 255, 0.24);
  }

  .project-links a {
    display: grid;
    min-height: 6.5rem;
    align-content: space-between;
    gap: var(--space-8);
    padding: var(--space-6) var(--space-6) var(--space-6) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.24);
    color: #ffffff;
    text-decoration: none;
  }

  .project-links a:nth-child(even) {
    padding-right: 0;
    padding-left: var(--space-6);
    border-left: 1px solid rgba(255, 255, 255, 0.24);
  }

  .project-links span {
    color: rgba(255, 255, 255, 0.5);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-links strong {
    color: inherit;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.6vw, 1.6rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .project-links a:hover strong {
    color: var(--color-signal-mist);
  }

  .back-link {
    grid-column: 1 / -1;
  }

  .direct-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
  }

  .text-link {
    border-color: rgba(255, 255, 255, 0.46);
    color: #ffffff;
  }

  .text-link:hover {
    border-color: #ffffff;
    color: #ffffff;
  }

  @media (max-width: 48rem) {
    .project-links {
      grid-template-columns: 1fr;
    }

    .project-links a,
    .project-links a:nth-child(even) {
      min-height: 6rem;
      padding: var(--space-6) 0;
      border-left: 0;
    }

    .back-link {
      grid-column: auto;
    }
  }
</style>
