---
interface Props {
  id: string;
  kind?: "overview" | "insight" | "decisions" | "prototype" | "reflection";
  title?: string;
  label?: string;
  layout?: "reading" | "wide";
}

const { id, kind, title, label, layout = "reading" } = Astro.props;

const sectionDefaults = {
  overview: { label: "Project context", title: "Overview" },
  insight: { label: "Research direction", title: "Key Insight" },
  decisions: { label: "What shaped the work", title: "Design Decisions" },
  prototype: { label: "How it works", title: "Prototype & Experience" },
  reflection: { label: "What changed", title: "Outcome & Reflection" },
} as const;

const defaults = kind ? sectionDefaults[kind] : undefined;
const resolvedTitle = title ?? defaults?.title;
const resolvedLabel = label ?? defaults?.label;
---

<section id={id} class:list={["case-section", `case-section--${layout}`]}>
  <header class="section-heading">
    {resolvedLabel && <p class="eyebrow">{resolvedLabel}</p>}
    {resolvedTitle && <h2>{resolvedTitle}</h2>}
  </header>

  <div class="section-content">
    <slot />
  </div>
</section>

<style>
  .case-section {
    display: grid;
    grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-16);
    padding: var(--section-space) var(--page-gutter);
    border-top: var(--line);
    scroll-margin-top: 4.2rem;
  }

  .section-heading {
    align-self: start;
  }

  h2 {
    max-width: 10ch;
    margin-top: var(--space-6);
    font-size: clamp(2.4rem, 4.2vw, 5rem);
  }

  .section-content {
    min-width: 0;
    max-width: var(--reading-width);
  }

  .case-section--wide .section-content {
    max-width: none;
  }

  .section-content :global(> p) {
    margin-bottom: var(--space-6);
    font-size: clamp(1.08rem, 1rem + 0.28vw, 1.25rem);
    line-height: 1.66;
  }

  .section-content :global(> h3) {
    margin: var(--space-12) 0 var(--space-4);
    font-size: clamp(1.5rem, 2.5vw, 2.4rem);
  }

  @media (min-width: 64.01rem) {
    .section-heading {
      position: sticky;
      top: 6.8rem;
    }
  }

  @media (max-width: 64rem) {
    .case-section {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }
</style>
