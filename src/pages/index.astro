---
import { getCollection } from "astro:content";
import AboutPanel from "../components/layout/AboutPanel.astro";
import IdentityRail from "../components/layout/IdentityRail.astro";
import ProjectSummary from "../components/project/ProjectSummary.astro";
import { siteData } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredProjects = (await getCollection("projects"))
  .filter(
    ({ data }) =>
      data.status === "published" && data.featuredOrder !== undefined,
  )
  .sort((a, b) => a.data.featuredOrder! - b.data.featuredOrder!);
const selectedProjects = featuredProjects.filter(
  ({ data }) => data.homeSection === "projects",
);
const otherProjects = featuredProjects.filter(
  ({ data }) => data.homeSection === "others",
);
---

<BaseLayout title={siteData.title} description={siteData.description}>
  <main id="main-content" class="site-shell">
    <IdentityRail />
    <div class="content-stream">
      <AboutPanel />

      <section
        id="projects"
        class="projects-section"
        aria-labelledby="projects-title"
      >
        <span id="work" class="anchor-alias" aria-hidden="true"></span>
        <header class="section-heading">
          <h2 id="projects-title">Selected Projects</h2>
          <p>Research, design & making.</p>
        </header>
        <div class="project-grid">
          {
            selectedProjects.map((project) => (
              <ProjectSummary project={project} />
            ))
          }
        </div>
        {
          selectedProjects.length === 0 && (
            <p class="empty-state">New work is on its way.</p>
          )
        }
      </section>

      <section
        id="others"
        class="background-section"
        aria-labelledby="others-title"
        data-content-status={otherProjects.length ? "ready" : "pending"}
      >
        <header class="section-heading">
          <h2 id="others-title">Others</h2>
          <p>My playground: writing, film, data, robots and more to come.</p>
        </header>
        <div class="project-grid">
          {otherProjects.map((project) => <ProjectSummary project={project} />)}
        </div>
        {
          otherProjects.length === 0 && (
            <p class="empty-state">More explorations are on their way.</p>
          )
        }
      </section>

      <footer class="site-footer">
        <span
          class="site-footer-status"
          data-footer-status={JSON.stringify(siteData.footerStatuses)}
          >{siteData.footerStatuses[0].text}</span
        >
        <a class="site-footer-cta" href={`mailto:${siteData.email}`}
          >Say hello <span aria-hidden="true">↗</span></a
        >
        <span class="site-footer-clock">
          <time data-local-clock data-time-zone={siteData.footerTimeZone}
          ></time>
          Ann Arbor, MI
        </span>
      </footer>
    </div>
  </main>
</BaseLayout>

<script>
  // Footer: live Ann Arbor time, plus a status line that follows that clock
  // (the statuses and time zone come from src/data/site.ts).
  const clock = document.querySelector<HTMLTimeElement>("[data-local-clock]");
  const status = document.querySelector<HTMLElement>("[data-footer-status]");
  if (clock) {
    const timeZone = clock.dataset.timeZone;
    const timeFormat = new Intl.DateTimeFormat("en-US", {
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: true,
      timeZone,
    });
    const hourFormat = new Intl.DateTimeFormat("en-US", {
      hour: "numeric",
      hour12: false,
      timeZone,
    });
    const statuses: { from: number; text: string }[] = status
      ? JSON.parse(status.dataset.footerStatus ?? "[]")
      : [];
    const tick = () => {
      const now = new Date();
      clock.dateTime = now.toISOString();
      clock.textContent = timeFormat.format(now);
      if (status && statuses.length) {
        const hour = Number(hourFormat.format(now)) % 24;
        const current = [...statuses]
          .reverse()
          .find((entry) => hour >= entry.from);
        status.textContent = (current ?? statuses[statuses.length - 1]).text;
      }
    };
    tick();
    window.setInterval(tick, 1000);
  }
</script>

<style>
  .site-shell {
    display: grid;
    grid-template-columns: var(--identity-width) minmax(0, 1fr);
    align-items: start;
    gap: 3rem;
    width: min(100%, var(--home-max));
    margin-inline: auto;
    padding: 3rem var(--page-gutter) 1.5rem;
  }

  .content-stream {
    display: grid;
    gap: 3.5rem;
    min-width: 0;
  }

  .projects-section,
  .background-section {
    position: relative;
    min-width: 0;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 1.5rem;
  }

  h2 {
    font-size: clamp(1.5rem, 2.2vw, 1.9rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .section-heading p {
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 1.5rem;
  }

  .background-section {
    padding-top: 1.75rem;
    border-top: var(--line);
  }

  .empty-state {
    font-size: 0.95rem;
  }

  /* Footer: status (left) · Say hello (centre) · local time (right) */
  .site-footer {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.25rem;
    border-top: var(--line);
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .site-footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 44px;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .site-footer-cta:hover,
  .site-footer-cta:focus-visible {
    color: var(--color-accent);
  }

  .site-footer-clock {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .site-footer-clock time:not(:empty)::after {
    content: " / ";
  }

  @media (max-width: 48rem) {
    .site-footer {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
      justify-items: center;
      text-align: center;
    }

    .site-footer-clock {
      text-align: center;
    }
  }

  @media (max-width: 60rem) {
    .site-shell {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
      padding-top: 2rem;
    }
  }

  @media (max-width: 38rem) {
    .content-stream {
      gap: 2.5rem;
    }

    .project-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .section-heading p {
      display: none;
    }
  }
</style>
